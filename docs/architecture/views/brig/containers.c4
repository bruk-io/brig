// Containers -- Brig: the library linked into the embedder's process, the
// supervisor it starts as each jail's PID 1 (decision-0002), and the egress
// proxy it starts on the host for a jail with an egress policy
// (decision-0009).
views {
  view brigContainers of brig {
    title 'Containers -- Brig'
    include *
  }
}
