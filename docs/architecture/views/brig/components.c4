// Components -- the Library container. The supervisor container is not
// decomposed (one small program whose parts are code; see
// models/brig/supervisor.c4), so it appears here only as the container the
// Supervisor Link starts.
views {
  view brigLibraryComponents of brig.library {
    title 'Components -- Brig Library'
    include *

    // Visual grouping only (decision-0001 rule 1), not a fourth abstraction
    // level: domain and infra depend on neither presentation nor each other.
    group 'domain' {
      include effects, operations, teardown, plan, policy, channels, grades, bwrapJailType
    }
    group 'infra' {
      include processes, sockets, files, placeholders, stateDir, supervisorLink, proxyLink, logEnvelope
    }
    group 'presentation' {
      include api, jail, driver, bwrapDriver, ports, errors, report
    }
  }
}
