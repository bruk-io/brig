// Component: presentation/drivers/bwrap.py and presentation/driver.py.
model {
  extend brig.library {
    bwrapDriver = component 'Bwrap Driver' {
      technology 'Python 3.15'
      description 'bwrap\'s slice of presentation: refuses and compiles the policy, writes the supervisor script and starts the jail, through the shared driver that performs the effects an operation or teardown yields, translating each into a port call and back.'
    }
  }
}
