// Component: domain/jail_types/seatbelt.py (decision-0001 rule 3, decision-0010).
model {
  extend brig.library {
    seatbeltJailType = component 'Seatbelt Jail Type' {
      technology 'Python 3.15'
      description 'Seatbelt\'s slice of the domain: compiles an FsPolicy into one ordered tuple of SBPL rules and renders the sandbox profile from a t-string template that refuses a plain str (decision-0001 rule 16, decision-0010), builds the sandbox-exec supervisor launch argv and the Plan it runs, and states each claim\'s ceiling on Darwin. No I/O itself.'
    }
  }
}
