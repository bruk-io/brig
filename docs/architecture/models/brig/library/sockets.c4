// Component: infra/sockets.py.
model {
  extend brig.library {
    sockets = component 'Sockets' {
      technology 'Python 3.15, stdlib only'
      description 'Channels on the real host: creates and removes a jail\'s channel directory, finds and holds the jail\'s PID namespace, verifies a channel is ready -- a connect confirmed, by PID namespace, to be the jailed process\'s own listener, never path existence (decision-0005) -- and signals the jail\'s PID 1. Plain data in and out.'
    }
  }
}
