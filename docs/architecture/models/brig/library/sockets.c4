// Component: infra/sockets.py.
model {
  extend brig.library {
    sockets = component 'Sockets' {
      technology 'Python 3.15, stdlib only'
      description 'Channels on the real host: creates, opens and removes a jail\'s channel directory, finds and holds the jail\'s PID namespace, verifies a channel is ready -- a non-blocking connect to the socket opened by name beneath the held directory fd through no link, confirmed, by PID namespace, to be the jailed process\'s own listener, never path existence (decision-0005, TASK-0045) -- and signals the jail\'s PID 1. Plain data in and out.'
    }
  }
}
