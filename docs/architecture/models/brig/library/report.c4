// Component: presentation/report.py.
model {
  extend brig.library {
    report = component 'Report' {
      technology 'Python 3.15'
      description 'Renders a jail\'s report as text, one line per claim with its grade and what it asserts, then, for a jail with an egress policy, its grants as created and every change since. Returned, never printed (rule 14).'
    }
  }
}
