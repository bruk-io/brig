// Component: presentation/api.py and presentation/jail.py.
model {
  extend brig.library {
    api = component 'API' {
      technology 'Python 3.15'
      description 'What an embedder calls for any jail type: reserving channels, waiting for one to be ready, waiting for the command\'s exit, and teardown; with the Jail value and the real ports\' default wiring onto infra.'
    }
  }
}
