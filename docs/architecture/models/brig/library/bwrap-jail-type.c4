// Component: domain/jail_types/bwrap.py.
model {
  extend brig.library {
    bwrapJailType = component 'Bwrap Jail Type' {
      technology 'Python 3.15'
      description 'bwrap\'s slice of the domain: compiles an FsPolicy into one ordered tuple of mounts and renders bwrap\'s flags from it (decision-0007), builds the supervisor\'s launch argv and the Plan it runs, and states each claim\'s ceiling, the jail\'s report (decision-0008). No I/O itself.'
    }
  }
}
