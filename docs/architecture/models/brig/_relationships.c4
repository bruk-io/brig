// Intra-system relationships for Brig (container<->container,
// component<->component). Explicit endpoints only — no it/this, no sourceless
// `-> x`. Inter-process edges carry a nested `technology`.
//
// Every component edge below is an import in src/brig. decision-0001 rule 1
// at component scope: domain and infra components depend on neither
// presentation nor each other's layer; presentation's components depend on
// both.
model {
  // The library -> supervisor container edge is derived from this one
  // (decision-0002): the host's end of the wire starts the supervisor, inside
  // bwrap, as PID 1 of the jail's own PID namespace. It names the container,
  // not a part of it, since the supervisor is not decomposed.
  extend brig {
    library.supervisorLink -> supervisor 'starts as the jail\'s PID 1, and exchanges wire messages with,' {
      technology 'newline-delimited JSON over pipes on fds 3 and 4'
    }
    // decision-0009 items 1 and 2: the jail's one route out. The supervisor
    // listens on the jail's loopback and hands each connection to the proxy,
    // which alone reaches the network.
    library.proxyLink -> egressProxy 'starts with its program on stdin, sends the grants to, and ends,' {
      technology 'a JSON line on a pipe on fd 3'
    }
    supervisor -> egressProxy 'hands each connection accepted on the jail\'s loopback to' {
      technology 'one end of a socketpair per connection, sent with SCM_RIGHTS over a SOCK_SEQPACKET pair (fds 5 and 4), then relayed bytes'
    }
  }

  brig.egressProxy -> network 'connects to the addresses the egress decision allowed on' {
    technology 'TCP'
  }

  extend brig.library {
    // domain, internal to the layer
    operations -> effects 'yields effect values from'
    operations -> plan 'reads the argv and candidate environment from'
    operations -> teardown 'delegates the kill ladder to'
    operations -> policy 'scrubs the environment with'
    teardown -> effects 'yields effect values from'
    bwrapJailType -> plan 'compiles a request into'
    bwrapJailType -> policy 'compiles the FsPolicy, and sets the proxy variables, with'
    bwrapJailType -> channels 'binds the channel directory of'
    bwrapJailType -> grades 'states each claim\'s ceiling as'

    // infra, internal to the layer
    supervisorLink -> processes 'spawns the supervisor through'
    supervisorLink -> proxyLink 'starts a jail\'s egress proxy before its supervisor, and ends it on close, through'
    proxyLink -> processes 'spawns, kills and reaps the egress proxy through'
    proxyLink -> supervisorLink 'shares the version guard of the supervisor\'s file with'

    // presentation, internal to the layer
    api -> driver 'runs start through'
    api -> jail 'tears down with dismantle, and finds the real ports in,'
    api -> errors 'raises failures as'
    api -> ports 'calls infra through'
    bwrapDriver -> driver 'runs create through'
    bwrapDriver -> jail 'builds the Jail, cleans up a failed create with dismantle, and finds the real ports in,'
    bwrapDriver -> errors 'raises refusals and infra failures as'
    bwrapDriver -> api 'refuses a malformed egress policy with'
    bwrapDriver -> ports 'calls infra through'
    driver -> errors 'raises a failed start as'
    driver -> ports 'performs each effect through'
    jail -> driver 'runs the destroy generator through'
    jail -> errors 'raises an invalid state directory as'
    jail -> ports 'wires real infra behind the protocols of'

    // presentation -> domain (rule 1: presentation knows domain)
    api -> operations 'drives the start generator of'
    api -> channels 'reserves channels with'
    api -> effects 'narrows exit and teardown outcomes using'
    bwrapDriver -> operations 'drives the create generator of'
    bwrapDriver -> bwrapJailType 'compiles the mounts, the supervisor launch and the ceilings with'
    bwrapDriver -> policy 'refuses what cannot compile, and an environment policy naming a proxy variable, with'
    bwrapDriver -> proxyLink 'assembles the egress proxy from the decision\'s source, and describes its launch, with'
    bwrapDriver -> channels 'binds the reservations of'
    driver -> effects 'performs the effects defined in'
    jail -> operations 'drives the destroy generator of'
    jail -> effects 'names the supervisor\'s process, and reads the teardown outcome, with'
    jail -> grades 'carries the report as'
    jail -> bwrapJailType 'carries the compiled mounts of'
    errors -> effects 'names the failed process using'
    ports -> effects 'states exit outcomes with'
    report -> grades 'renders the claims and grades of'

    // presentation -> infra (rule 1: presentation knows infra)
    api -> sockets 'interrupts the jail\'s PID 1 through'
    bwrapDriver -> files 'looks up the policy\'s host facts through'
    bwrapDriver -> sockets 'opens the channel directory\'s fd, and finds the jail\'s PID namespace, through'
    bwrapDriver -> stateDir 'makes the empty read-only directory through'
    bwrapDriver -> supervisorLink 'assembles the supervisor file, and builds the live supervisor, with'
    driver -> supervisorLink 'catches start and wire failures from'
    jail -> placeholders 'wires the placeholder port onto'
    jail -> processes 'wires the process port onto'
    jail -> sockets 'wires the channel ports onto'
    jail -> stateDir 'resolves brig\'s state directory through'
    jail -> supervisorLink 'wires the supervisor port onto'
  }
}
