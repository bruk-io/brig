// Container: the supervisor (decision-0002) -- infra/supervisor/wire.py and
// infra/supervisor/program.py, assembled by infra/supervisor/assemble.py into
// the one stdlib-only file bwrap runs as PID 1 inside each jail
// (decision-0001 rule 17). link.py, the host's end of the same wire, stays in the library
// container (component `supervisorLink`), never here.
//
// Not decomposed into components: it is one ~180-line program with no
// interface inside it, so its parts are code, not components. wire.py's
// source crosses in with program.py, but program.py repeats wire.py's numbers
// and shapes by convention rather than importing them (decision-0002 item 1).
model {
  extend brig {
    supervisor = container 'Supervisor' {
      technology 'Python 3.15, stdlib only'
      description 'PID 1 inside each jail\'s own PID namespace: makes itself non-dumpable first (decision-0006), reads one exec request, starts the command as its child, reaps everything reparented to it, and reports started, exited and done, so the host tracks exactly one process. With an egress policy it listens on the jail\'s loopback before the command starts and bridges each connection to the egress proxy, copying bytes it never reads (decision-0009 item 1).'
    }
  }
}
